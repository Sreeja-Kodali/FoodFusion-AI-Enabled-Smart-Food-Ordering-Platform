# Copy to .env, replace the placeholders, then load MONGODB_URI in PowerShell
# before running Product Service:
# $env:MONGODB_URI = (Get-Content .env | Where-Object { $_ -match '^MONGODB_URI=' } | Select-Object -First 1) -replace '^MONGODB_URI=', ''
# Keep the database path set to /foodfusion. Never commit the populated .env file.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/foodfusion?retryWrites=true&w=majority
